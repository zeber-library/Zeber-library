{
    "version": 2,
    "builds": [
      {
        "src": "frontend/package.json",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "frontend/build"
        }
      },
      {
        "src": "api/**/*.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/LibraryProfile",
        "dest": "/api/file1.js"
      },
      {
        "src": "/api/UploadBook",
        "dest": "/api/index.js"
      },
      {
        "src": "/api/AdminBookUpload\backend",
        "dest": "/api/server.js"
      },
      {
        "src": "/api/auth",
        "dest": "/api/file4.js"
      },
      {
        "src": "/(.*)",
        "dest": "/ZeberFrontend/dist/$1"
      }
    ]
  }
  